# Leave empty for SQLite at data/careerscout.db.
DATABASE_URL=
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Vercel requires persistent PostgreSQL; POSTGRES_URL is accepted as a fallback.
CAREERSCOUT_USER_AGENT=CareerScoutGermany/1.0 (personal job discovery)
# Required on Vercel; optional locally. Vercel login username: careerscout.
APP_PASSWORD=
# Optional LLM advice only, never used during collection or scoring.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
